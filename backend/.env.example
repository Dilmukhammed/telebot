# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# SQLite database URL (async)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Secret key for JWT admin tokens
ADMIN_JWT_SECRET=change-me-to-random-secret

# Webhook URL (use localhost for dev, ngrok for testing)
WEBHOOK_URL=http://localhost:8000/bot/webhook